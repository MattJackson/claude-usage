---
// The canonical two-line install: brew install + `install` subcommand.
import CodeBlock from './CodeBlock.astro';
---
<CodeBlock label="install">
<span class="c"># Homebrew tap → single Rust binary, no runtime, no webview</span>
<span class="p">$</span> brew tap --trust mattjackson/tap
<span class="p">$</span> brew install mattjackson/tap/usagio
<span class="p">$</span> usagio install   <span class="c"># menu-bar app + auto-swap, now and every login</span>
</CodeBlock>

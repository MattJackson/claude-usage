---
// Sticky, translucent top bar. Brand mark on the left, primary nav
// (Download + GitHub icon + theme toggle) on the right. `current`
// highlights the active page. Theme-toggle init runs before first paint
// from Base.astro to avoid FOUC on manual overrides.
export interface Props { current?: 'home' | 'download' }
const { current } = Astro.props;
const github = 'https://github.com/MattJackson/claude-usage';
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/" aria-label="usagio home">
      <img class="brand-mark" src="/logo.svg" alt="" width="28" height="28" />
      <span>usagio</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/download/" aria-current={current === 'download' ? 'page' : undefined}>Download</a>
      <a href={github} target="_blank" rel="noopener noreferrer" class="header-github" aria-label="View source on GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
      </a>
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Toggle color theme"
        title="Toggle light / dark"
      >
        <span class="glyph-light" aria-hidden="true">☀</span>
        <span class="glyph-dark" aria-hidden="true">🌙</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .header-github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border-radius: 8px;
    color: var(--ink-2);
    opacity: 0.6;
    transition: opacity 140ms ease, background 140ms ease, color 140ms ease;
  }
  .header-github:hover {
    opacity: 1;
    color: var(--ink);
    background: var(--bg-soft);
  }
  .header-github:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

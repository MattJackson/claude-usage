---
// Full changelog, rendered on-site GitHub-releases style so nobody has to
// leave usagio.dev to see what changed. Source of truth is CHANGELOG.md in
// the CLI repo (Keep a Changelog format); ../data/CHANGELOG.md is a synced
// snapshot copied in at doc-update time via:
//   git -C <cli-repo> show origin/main:CHANGELOG.md > web/src/data/CHANGELOG.md
// Each `## [x.y.z] - date` section is parsed out, rendered independently
// through the same remark/rehype pipeline Astro's own Markdown pages use,
// and wrapped with a "View on GitHub" link back to the release tag.
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkRehype from 'remark-rehype';
import rehypeStringify from 'rehype-stringify';
import Base from '../layouts/Base.astro';
import changelogRaw from '../data/CHANGELOG.md?raw';

const title = "What's new in usagio";
const description =
  'Full usagio changelog: every release, grouped Added / Changed / Fixed / Removed, reverse-chronological.';

const github = 'https://github.com/MattJackson/usagio';

const processor = unified().use(remarkParse).use(remarkGfm).use(remarkRehype).use(rehypeStringify);

const versionHeader = /^## \[([^\]]+)\](?:\s*-\s*(.+?))?\s*$/gm;
const matches = [...changelogRaw.matchAll(versionHeader)];

const rawEntries = matches
  .map((m, i) => {
    const version = m[1].trim();
    const date = m[2]?.trim();
    const start = (m.index ?? 0) + m[0].length;
    const end = i + 1 < matches.length ? matches[i + 1].index ?? changelogRaw.length : changelogRaw.length;
    let body = changelogRaw.slice(start, end);
    // Drop the trailing "[x.y.z]: https://…/compare/…" link-reference
    // footer that lives after the final version's content.
    const linkRefStart = body.search(/\n\[[^\]]+\]:\s*https?:\/\//);
    if (linkRefStart !== -1) body = body.slice(0, linkRefStart);
    return { version, date, body: body.trim() };
  })
  .filter((e) => e.version.toLowerCase() !== 'unreleased' && e.body.length > 0);

const entries = await Promise.all(
  rawEntries.map(async (e) => {
    const html = String(await processor.process(e.body));
    return { ...e, html };
  })
);
---
<Base title={title} description={description} path="/whats-new/" current="whats-new">

  <!-- ============ HERO ============ -->
  <section class="cl-hero">
    <div class="container container-narrow" style="text-align: center;">
      <span class="eyebrow fade-up">Changelog</span>
      <h1 class="h-display fade-up" style="font-size: clamp(2.2rem, 5vw, 3.4rem); margin-top: 0.5rem;">What's new</h1>
      <p class="lede fade-up" style="margin: 1rem auto 0;">
        Every usagio release, in one place — no need to hop over to GitHub.
        Newest first.
      </p>
    </div>
  </section>

  <!-- ============ ENTRIES ============ -->
  <section class="cl-section">
    <div class="container container-narrow">
      {entries.map((entry, i) => (
        <>
          {i > 0 && <hr class="cl-divider" />}
          <article class="cl-entry fade-up">
            <div class="cl-entry-head">
              <h2 class="h-section">
                v{entry.version}{entry.date && <span class="cl-date"> — {entry.date}</span>}
              </h2>
              <a
                class="cl-gh-link"
                href={`${github}/releases/tag/v${entry.version}`}
                target="_blank"
                rel="noopener noreferrer"
              >View on GitHub&nbsp;→</a>
            </div>
            <div class="cl-body" set:html={entry.html} />
          </article>
        </>
      ))}
    </div>
  </section>

</Base>

<style>
  .cl-hero {
    padding: clamp(3rem, 8vw, 5rem) 0 clamp(2rem, 5vw, 3rem);
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(91,43,234,0.06), transparent 65%),
      var(--bg);
    border-bottom: var(--hairline);
  }
  .cl-section { padding: clamp(2.5rem, 6vw, 3.5rem) 0 clamp(4rem, 8vw, 6rem); }
  .cl-entry { padding: 1.75rem 0; }
  .cl-entry:first-of-type { padding-top: 0; }
  .cl-entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }
  .cl-entry-head .h-section { margin: 0; }
  .cl-date { color: var(--muted); font-weight: 500; font-size: 0.7em; }
  .cl-gh-link {
    color: var(--accent);
    font-weight: 600;
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  .cl-gh-link:hover { color: var(--accent-hover); }
  .cl-divider {
    border: none;
    border-top: var(--hairline);
    margin: 0.5rem 0;
    opacity: 0.6;
  }

  .cl-body :global(p) {
    color: var(--muted);
    line-height: 1.65;
    margin: 0 0 1rem;
  }
  .cl-body :global(h3) {
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 1.25rem 0 0.6rem;
  }
  .cl-body :global(h3:first-child) { margin-top: 0; }
  .cl-body :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.75rem;
  }
  .cl-body :global(li) {
    color: var(--muted);
    line-height: 1.6;
    font-size: 0.95rem;
    padding-left: 1.1rem;
    position: relative;
  }
  .cl-body :global(li)::before {
    content: "";
    position: absolute; left: 0; top: 0.55em;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
  }
  .cl-body :global(li > ul) { margin-top: 0.5rem; }
  .cl-body :global(strong) { color: var(--ink); font-weight: 650; }
  .cl-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--accent-tint);
    color: var(--accent);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }
  .cl-body :global(a) { color: var(--accent); font-weight: 600; }
  .cl-body :global(a:hover) { color: var(--accent-hover); }
</style>

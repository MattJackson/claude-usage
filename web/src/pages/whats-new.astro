---
// Full changelog, rendered on-site GitHub-releases style so nobody has to
// leave usagio.dev to see what changed. Source of truth is CHANGELOG.md in
// the CLI repo (Keep a Changelog format); ../data/CHANGELOG.md is a synced
// snapshot copied in at doc-update time via:
//   git -C <cli-repo> show origin/main:CHANGELOG.md > web/src/data/CHANGELOG.md
// Each `## [x.y.z] - date` section is parsed out, rendered independently
// through the same remark/rehype pipeline Astro's own Markdown pages use,
// and wrapped with a "View on GitHub" link back to the release tag.
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkRehype from 'remark-rehype';
import rehypeStringify from 'rehype-stringify';
import Base from '../layouts/Base.astro';
import changelogRaw from '../data/CHANGELOG.md?raw';

const title = "What's new in usagio";
const description =
  'Full usagio changelog: every release, grouped Added / Changed / Fixed / Removed, reverse-chronological.';

const github = 'https://github.com/MattJackson/usagio';

const processor = unified().use(remarkParse).use(remarkGfm).use(remarkRehype).use(rehypeStringify);

const versionHeader = /^## \[([^\]]+)\](?:\s*-\s*(.+?))?\s*$/gm;
const matches = [...changelogRaw.matchAll(versionHeader)];

const rawEntries = matches
  .map((m, i) => {
    const version = m[1].trim();
    const date = m[2]?.trim();
    const start = (m.index ?? 0) + m[0].length;
    const end = i + 1 < matches.length ? matches[i + 1].index ?? changelogRaw.length : changelogRaw.length;
    let body = changelogRaw.slice(start, end);
    // Drop the trailing "[x.y.z]: https://…/compare/…" link-reference
    // footer that lives after the final version's content.
    const linkRefStart = body.search(/\n\[[^\]]+\]:\s*https?:\/\//);
    if (linkRefStart !== -1) body = body.slice(0, linkRefStart);
    return { version, date, body: body.trim() };
  })
  .filter((e) => e.version.toLowerCase() !== 'unreleased' && e.body.length > 0);

const entries = await Promise.all(
  rawEntries.map(async (e) => {
    const html = String(await processor.process(e.body));
    return { ...e, html };
  })
);

// TechArticle node for the changelog page, merged into the site-wide @graph.
const changelogArticle = {
  '@type': 'TechArticle',
  '@id': 'https://usagio.dev/whats-new/#article',
  headline: "What's new in usagio",
  description,
  url: 'https://usagio.dev/whats-new/',
  ...(entries[0]?.date ? { dateModified: entries[0].date } : {}),
};
---
<Base title={title} description={description} path="/whats-new/" current="whats-new" jsonLd={changelogArticle}>

  <!-- ============ ENTRIES ============ -->
  <section class="cl-section">
    <div class="container container-narrow">
      <h1 class="cl-title fade-up">What's new</h1>

      {entries.map((entry, i) => (
        <>
          {i > 0 && <hr class="cl-divider" />}
          <article class="cl-entry fade-up">
            <div class="cl-entry-head">
              <h2 class="cl-version">
                v{entry.version}{entry.date && <span class="cl-date"> — {entry.date}</span>}
              </h2>
              <a
                class="cl-gh-link"
                href={`${github}/releases/tag/v${entry.version}`}
                target="_blank"
                rel="noopener noreferrer"
              >View on GitHub&nbsp;→</a>
            </div>
            <div class="cl-body" set:html={entry.html} />
          </article>
        </>
      ))}
    </div>
  </section>

</Base>

<style>
  .cl-section { padding: clamp(3rem, 7vw, 4.5rem) 0 clamp(4rem, 8vw, 6rem); }

  .cl-title {
    font-size: clamp(2rem, 4.4vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 2.5rem;
  }

  .cl-entry { padding: 1.5rem 0; }
  .cl-entry:first-of-type { padding-top: 0; }
  .cl-entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  /* Version header — one size, one weight. Date is the same size, just muted. */
  .cl-version {
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
  }
  .cl-date { color: var(--muted); font-weight: 400; }

  .cl-gh-link {
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 400;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .cl-gh-link:hover { color: var(--ink); text-decoration-color: currentColor; }

  .cl-divider {
    border: none;
    border-top: var(--hairline);
    margin: 0.5rem 0;
    opacity: 0.6;
  }

  /* ---- body: ONE body size everywhere. Subsection h3s differentiate by
     TREATMENT (uppercase + tracking + muted), not by another distinct size. */
  .cl-body :global(p),
  .cl-body :global(li) {
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.6;
    font-weight: 400;
    margin: 0 0 0.75rem;
  }
  .cl-body :global(p:last-child),
  .cl-body :global(li:last-child) { margin-bottom: 0; }

  .cl-body :global(h3) {
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    margin: 1.5rem 0 0.6rem;
  }
  .cl-body :global(h3:first-child) { margin-top: 0; }

  /* Any deeper heading levels the markdown might carry — flatten to h3 look. */
  .cl-body :global(h4),
  .cl-body :global(h5),
  .cl-body :global(h6) {
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    margin: 1.25rem 0 0.5rem;
  }

  .cl-body :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0 0 1rem;
  }
  .cl-body :global(li) { padding-left: 0.25rem; }
  .cl-body :global(li::marker) { color: var(--muted-2); }
  .cl-body :global(li > ul) { margin-top: 0.4rem; margin-bottom: 0; }

  .cl-body :global(strong) { color: var(--ink); font-weight: 600; }

  /* Inline code: mono font, muted color, same body size. No pill background. */
  .cl-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--muted);
  }

  /* Links: underlined at body weight, not bold + colored. */
  .cl-body :global(a) {
    color: var(--ink);
    font-weight: 400;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 2px;
  }
  .cl-body :global(a:hover) {
    text-decoration-color: currentColor;
  }
</style>

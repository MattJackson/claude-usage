---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';

const title = 'Download usagio';
const description =
  'Install usagio on macOS, Linux, or Windows. One Homebrew command on macOS and Linux, prebuilt archives for all three platforms. Free & MIT-licensed. Instructions for building from source.';

const github = 'https://github.com/MattJackson/usagio';
const releases = `${github}/releases`;
---
<Base title={title} description={description} path="/download/" current="download">

  <!-- ============ HERO ============ -->
  <section class="dl-hero">
    <div class="container container-narrow" style="text-align: center;">
      <img src="/logo.svg" width="72" height="72" alt="" class="dl-hero-logo fade-up" />
      <span class="eyebrow fade-up">Latest release</span>
      <h1 class="h-display fade-up" style="font-size: clamp(2.2rem, 5vw, 3.4rem); margin-top: 0.5rem;">Install usagio</h1>
      <p class="lede fade-up" style="margin: 1rem auto 0;">
        macOS, Linux, and Windows are all supported. On macOS and Linux, one
        Homebrew command puts the binary on your PATH and the tray app in
        your menu bar.
      </p>
    </div>
  </section>

  <!-- ============ BREW INSTALL ============ -->
  <section class="dl-primary">
    <div class="container container-narrow">
      <div class="dl-primary-card fade-up">
        <div class="dl-primary-head">
          <span class="eyebrow">Recommended</span>
          <h2 class="h-section">macOS</h2>
          <p class="dl-primary-lede">
            Installs the binary, wires up the menu-bar agent, and auto-launches
            it on login. Upgrades come through <code>brew upgrade</code>; a running
            app relaunches into the new binary without you restarting anything.
          </p>
        </div>
        <CodeBlock label="install">
<span class="c"># 1 — Approve the third-party tap (once)</span>
<span class="p">$</span> brew tap --trust mattjackson/tap

<span class="c"># 2 — Install</span>
<span class="p">$</span> brew install mattjackson/tap/usagio

<span class="c"># 3 — Set up the menu-bar app + auto-swap daemon (now and every login)</span>
<span class="p">$</span> usagio install
</CodeBlock>
        <div class="btn-row" style="justify-content: center; margin-top: 1.5rem;">
          <button
            type="button"
            class="btn btn-brand btn-brand-lg"
            data-copy="brew tap --trust mattjackson/tap && brew install mattjackson/tap/usagio"
            aria-label="Copy brew install command to clipboard"
          >Copy install command</button>
          <a class="btn btn-secondary" href={releases} target="_blank" rel="noopener noreferrer">All releases on GitHub&nbsp;→</a>
        </div>
      </div>

      <!-- ============ LINUX INSTALL ============ -->
      <div class="dl-primary-card fade-up" style="margin-top: 1.5rem;">
        <div class="dl-primary-head">
          <span class="eyebrow">Linux</span>
          <h2 class="h-section">Homebrew (linuxbrew) or tarball</h2>
          <p class="dl-primary-lede">
            The same tap works on Linux via <a href="https://brew.sh" target="_blank" rel="noopener noreferrer">linuxbrew</a>.
            Prefer not to install Homebrew? Grab the tarball directly from the
            releases page instead.
          </p>
        </div>
        <CodeBlock label="install (linuxbrew)">
<span class="p">$</span> brew tap --trust mattjackson/tap
<span class="p">$</span> brew install mattjackson/tap/usagio
<span class="p">$</span> usagio install
</CodeBlock>
        <p class="dl-p" style="margin-top: 1.25rem;">Or, without Homebrew:</p>
        <CodeBlock label="install (tarball)">
<span class="c"># Download from the releases page, then:</span>
<span class="p">$</span> tar xzf usagio-v0.5.0-x86_64-unknown-linux-gnu.tar.gz
<span class="p">$</span> ./usagio watch

<span class="c"># Or register the tray app + auto-swap daemon at login</span>
<span class="c"># (writes ~/.config/autostart/usagio.desktop)</span>
<span class="p">$</span> ./usagio install
</CodeBlock>
      </div>

      <!-- ============ WINDOWS INSTALL ============ -->
      <div class="dl-primary-card fade-up" style="margin-top: 1.5rem;">
        <div class="dl-primary-head">
          <span class="eyebrow">Windows</span>
          <h2 class="h-section">Prebuilt archive</h2>
          <p class="dl-primary-lede">
            Download the zip from the releases page, extract it, and add it to
            your PATH.
          </p>
        </div>
        <CodeBlock label="install">
<span class="c"># Download usagio-v0.5.0-x86_64-pc-windows-msvc.zip from the releases page,</span>
<span class="c"># then extract to %LOCALAPPDATA%\Programs\usagio\ and add it to PATH.</span>

<span class="c"># Register the tray app + auto-swap daemon at login</span>
<span class="c"># (writes to HKCU\Software\Microsoft\Windows\CurrentVersion\Run)</span>
<span class="p">&gt;</span> usagio install
</CodeBlock>
        <p class="dl-p dl-p-fine">
          The exe is unsigned, so Windows Defender may show a SmartScreen
          warning on first run — choose "More info" → "Run anyway". See
          <code>packaging/windows/DEPENDENCIES.md</code> in the repo for details.
        </p>
      </div>

      <!-- ============ VERIFY ============ -->
      <div class="dl-verify fade-up">
        <h3 class="dl-h3">Verify the install</h3>
        <p class="dl-p">
          Confirm the binary is on your PATH and the version matches what you
          expected.
        </p>
        <CodeBlock label="verify">
<span class="p">$</span> usagio --version
<span class="p">$</span> usagio status
</CodeBlock>
      </div>

      <!-- ============ SYSTEM REQ ============ -->
      <div class="dl-req fade-up">
        <div class="dl-req-inner">
          <div>
            <div class="dl-req-label">Requires</div>
            <div class="dl-req-body">
              <strong>macOS 13 Ventura</strong> or later &middot; Apple Silicon or Intel.
              Uses the macOS Keychain and <code>launchd</code>.
            </div>
            <div class="dl-req-body" style="margin-top: 0.6rem;">
              <strong>Linux</strong> &middot; x86_64. Needs GTK 3,
              <code>libayatana-appindicator3</code>, <code>libsecret</code>, and
              an <code>xdg-desktop-portal</code> for the tray icon, credential
              storage, and autostart entry respectively.
            </div>
            <div class="dl-req-body" style="margin-top: 0.6rem;">
              <strong>Windows 10</strong> or later &middot; x86_64. Uses Windows
              Credential Manager and the Autostart Registry key.
            </div>
          </div>
        </div>
      </div>

      <!-- ============ HONESTY NOTE ============ -->
      <div class="dl-req fade-up" style="margin-top: 1.25rem;">
        <div class="dl-req-inner">
          <div>
            <div class="dl-req-label">v0.5.0 platform notes</div>
            <div class="dl-req-body">
              This is the first usagio release with Linux and Windows support.
              All three platforms build and pass CI, but real-world validation
              on Linux and Windows is still ongoing — please
              <a href={`${github}/issues`} target="_blank" rel="noopener noreferrer">file an issue</a>
              if something doesn't work as expected.
            </div>
            <div class="dl-req-body" style="margin-top: 0.6rem;">
              The macOS build is signed ad-hoc, not notarised, so the first
              launch may need a Right-Click → Open instead of a double-click.
              Signed and notarised builds are planned once the project has an
              Apple Developer account.
            </div>
            <div class="dl-req-body" style="margin-top: 0.6rem;">
              The Linux tray icon needs <code>libayatana-appindicator3</code>:
              <code>sudo apt install libayatana-appindicator3-1</code> on
              Ubuntu/Debian, <code>sudo dnf install libayatana-appindicator-gtk3</code>
              on Fedora, or <code>libayatana-appindicator</code> from the AUR on Arch.
            </div>
            <div class="dl-req-body" style="margin-top: 0.6rem;">
              The Windows build is unsigned, so Defender may need an exception
              on first run.
            </div>
          </div>
        </div>
      </div>

      <!-- ============ FROM SOURCE ============ -->
      <details class="dl-source fade-up">
        <summary>
          <span>Build from source</span>
          <span class="dl-source-hint">Rust 1.88+ · single <code>cargo build</code></span>
        </summary>
        <div class="dl-source-body">
          <p class="dl-p">
            Requires a recent stable Rust toolchain. The MSRV is <strong>1.88</strong>.
            The workspace builds one binary that powers both the menu-bar app
            and the CLI.
          </p>
          <CodeBlock label="build">
<span class="p">$</span> git clone https://github.com/MattJackson/usagio.git
<span class="p">$</span> cd usagio
<span class="p">$</span> cargo build --release

<span class="c"># Binary at target/release/usagio — copy anywhere on your PATH</span>
<span class="p">$</span> cp target/release/usagio /usr/local/bin/
<span class="p">$</span> usagio install
</CodeBlock>
          <p class="dl-p dl-p-fine">
            Contributing? The repo README covers the layout, tests, and the
            provider-adapter interface for adding new AI coding CLIs.
          </p>
        </div>
      </details>
    </div>
  </section>

</Base>

<style>
  .dl-hero {
    padding: clamp(3rem, 8vw, 5rem) 0 clamp(2rem, 5vw, 3rem);
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(91,43,234,0.06), transparent 65%),
      var(--bg);
    border-bottom: var(--hairline);
  }
  .dl-hero-logo {
    margin: 0 auto 1.5rem;
    filter: drop-shadow(0 18px 30px rgba(91,43,234,0.25));
  }

  .dl-primary { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .dl-primary-card {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    box-shadow: var(--shadow-2);
  }
  .dl-primary-head { text-align: center; margin-bottom: 1.5rem; }
  .dl-primary-head .eyebrow { margin-bottom: 0.4rem; }
  .dl-primary-head .h-section { margin-bottom: 0.5rem; }
  .dl-primary-lede {
    color: var(--muted);
    max-width: 54ch;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.6;
  }
  .dl-primary-head code,
  .dl-verify code,
  .dl-req code,
  .dl-source code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--accent-tint);
    color: var(--accent);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }

  .btn-brand-lg { padding: 0.9rem 1.4rem; font-size: 1rem; border-radius: var(--r-md); }

  .dl-verify {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }
  .dl-h3 {
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }
  .dl-p {
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1rem;
    max-width: 58ch;
  }
  .dl-p-fine { font-size: 0.9rem; color: var(--muted-2); }

  .dl-req {
    margin-top: clamp(2.5rem, 6vw, 3rem);
  }
  .dl-req-inner {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1.25rem 1.4rem;
  }
  .dl-req-label {
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .dl-req-body { color: var(--ink-2); font-size: 0.96rem; line-height: 1.55; }
  .dl-req-body strong { color: var(--ink); font-weight: 650; }

  .dl-source {
    margin-top: clamp(2rem, 5vw, 2.5rem);
    margin-bottom: clamp(3rem, 8vw, 5rem);
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-1);
  }
  .dl-source summary {
    cursor: pointer;
    list-style: none;
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem;
    font-weight: 600;
    color: var(--ink);
    padding: 0.35rem 0.1rem;
  }
  .dl-source summary::-webkit-details-marker { display: none; }
  .dl-source summary::after {
    content: "＋";
    color: var(--muted);
    font-weight: 400;
    transition: transform 200ms ease;
  }
  .dl-source[open] summary::after { content: "−"; }
  .dl-source-hint { color: var(--muted); font-weight: 500; font-size: 0.88rem; }
  .dl-source-body { padding-top: 1rem; }
</style>

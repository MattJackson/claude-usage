---
// Help / FAQ page. Short answers only — the long-form install prose lives on
// /download/ and in the repo's packaging docs. Each entry here should read in
// a couple of sentences, then link out.
import Base from '../layouts/Base.astro';

const title = 'FAQ — usagio';
const description =
  'Short answers to common usagio questions: install caveats, autostart, and where to look for more.';

const github = 'https://github.com/MattJackson/usagio';
---
<Base title={title} description={description} path="/faq/" current="faq">
  <section class="faq-section">
    <div class="container container-narrow">
      <h1 class="faq-title fade-up">FAQ</h1>
      <p class="faq-lede fade-up">
        Setup instructions live on <a href="/download/">/download/</a>. This
        page covers questions that come up after that.
      </p>

      <h2 class="faq-q fade-up">Windows SmartScreen warned me — is that expected?</h2>
      <p class="faq-a fade-up">
        Yes. The <code>.exe</code> is unsigned, so Defender flags it the first
        run. Choose <strong>More info → Run anyway</strong>.
      </p>

      <h2 class="faq-q fade-up">Where does autostart get registered?</h2>
      <p class="faq-a fade-up">
        Windows: per-user Run key at
        <code>HKCU\Software\Microsoft\Windows\CurrentVersion\Run</code>. Linux:
        <code>~/.config/autostart/usagio.desktop</code>. Both are removed by
        <code>usagio uninstall</code>.
      </p>

      <h2 class="faq-q fade-up">What Linux packages do I need?</h2>
      <p class="faq-a fade-up">
        GTK 3, <code>libayatana-appindicator3</code>, <code>libsecret</code>,
        and an <code>xdg-desktop-portal</code> backend — see
        <code>packaging/linux/DEPENDENCIES.md</code> if something is missing.
      </p>

      <h2 class="faq-q fade-up">Where are the release notes?</h2>
      <p class="faq-a fade-up">
        On-site at <a href="/whats-new/">What's New</a>, grouped by Added /
        Changed / Fixed / Removed.
      </p>

      <h2 class="faq-q fade-up">The binary isn't on my PATH.</h2>
      <p class="faq-a fade-up">
        Run <code>usagio --version</code> to confirm the install landed. If
        not, open an issue on
        <a href={`${github}/issues`} target="_blank" rel="noopener noreferrer">GitHub</a>
        with your OS and install method.
      </p>
    </div>
  </section>
</Base>

<style>
  .faq-section { padding: clamp(3rem, 7vw, 4.5rem) 0 clamp(4rem, 8vw, 6rem); }
  .faq-title {
    font-size: clamp(2rem, 4.4vw, 2.8rem);
    line-height: 1.1; letter-spacing: -0.03em; font-weight: 700;
    color: var(--ink); margin: 0 0 1rem;
  }
  .faq-lede {
    color: var(--muted); font-size: var(--fs-body); line-height: 1.55;
    max-width: 58ch; margin: 0 0 2.5rem;
  }
  .faq-q {
    font-size: 1.05rem; line-height: 1.35; letter-spacing: -0.01em;
    font-weight: 600; color: var(--ink); margin: 1.75rem 0 0.4rem;
  }
  .faq-a {
    color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.6;
    max-width: 62ch; margin: 0;
  }
  .faq-a code { font-family: var(--font-mono); font-size: 0.92em; color: var(--muted); }
  .faq-a strong { color: var(--ink); font-weight: 600; }
  .faq-a a, .faq-lede a {
    color: var(--ink); text-decoration: underline;
    text-decoration-color: var(--line-strong); text-underline-offset: 2px;
  }
  .faq-a a:hover, .faq-lede a:hover { text-decoration-color: currentColor; }
</style>

---
// Help / FAQ page. Home for the platform-specific install caveats that used
// to clutter /download/ (Windows SmartScreen, autostart registry/desktop-
// entry detail) so that page can stay a clean "run this command" reference.
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';

const title = 'FAQ — usagio';
const description =
  'Answers to common usagio questions: Windows SmartScreen warnings, autostart registration details, and troubleshooting install issues.';

const github = 'https://github.com/MattJackson/usagio';
---
<Base title={title} description={description} path="/faq/" current="faq">

  <!-- ============ HERO ============ -->
  <section class="faq-hero">
    <div class="container container-narrow" style="text-align: center;">
      <span class="eyebrow fade-up">Help</span>
      <h1 class="h-display fade-up" style="font-size: clamp(2.2rem, 5vw, 3.4rem); margin-top: 0.5rem;">FAQ</h1>
      <p class="lede fade-up" style="margin: 1rem auto 0;">
        Platform-specific install notes and answers to things that come up
        after you've downloaded usagio.
      </p>
    </div>
  </section>

  <!-- ============ WINDOWS ============ -->
  <section class="faq-section">
    <div class="container container-narrow">
      <h2 class="h-section fade-up">Installing on Windows</h2>
      <p class="faq-p fade-up">
        The <code>.exe</code> is unsigned, so Windows Defender may show a
        SmartScreen warning ("Windows protected your PC") the first time you
        run it. Choose <strong>More info</strong> → <strong>Run anyway</strong> to
        continue. This is expected for an independent, unsigned open-source
        binary — see
        <code>packaging/windows/DEPENDENCIES.md</code> in the repo for the
        full build/signing story.
      </p>
      <p class="faq-p fade-up">
        Running <code>usagio install</code> writes an autostart entry to
        <code>HKCU\Software\Microsoft\Windows\CurrentVersion\Run</code> so the
        tray app and auto-swap daemon start on login. This is a per-user
        registry key (no admin rights needed); <code>usagio uninstall</code> removes
        it cleanly.
      </p>
    </div>
  </section>

  <!-- ============ LINUX ============ -->
  <section class="faq-section section-soft">
    <div class="container container-narrow">
      <h2 class="h-section fade-up">Installing on Linux</h2>
      <p class="faq-p fade-up">
        <code>usagio install</code> registers autostart by writing a standard
        XDG desktop entry to <code>~/.config/autostart/usagio.desktop</code> —
        no system-level changes, no root required. Your desktop environment
        picks it up on next login.
      </p>
      <p class="faq-p fade-up">
        The tray icon, credential storage, and autostart entry need GTK 3,
        <code>libayatana-appindicator3</code>, <code>libsecret</code>, and an
        <code>xdg-desktop-portal</code> implementation respectively. Most
        desktop distros ship these already; see the
        <code>packaging/linux/DEPENDENCIES.md</code> in the repo if a package
        is missing.
      </p>
    </div>
  </section>

  <!-- ============ RELEASE NOTES ============ -->
  <section class="faq-section">
    <div class="container container-narrow">
      <h2 class="h-section fade-up">Where are the release notes?</h2>
      <p class="faq-p fade-up">
        The full changelog lives on-site at <a href="/whats-new/">What's New</a> —
        every release, grouped by Added / Changed / Fixed / Removed. Each
        entry also links out to its GitHub release for raw commit history.
      </p>
    </div>
  </section>

  <!-- ============ VERIFY / TROUBLESHOOT ============ -->
  <section class="faq-section section-soft">
    <div class="container container-narrow">
      <h2 class="h-section fade-up">The binary isn't found on my PATH</h2>
      <p class="faq-p fade-up">
        Confirm the install actually landed and check the version:
      </p>
      <CodeBlock label="verify"><span class="p">$</span> usagio --version
<span class="p">$</span> usagio status
</CodeBlock>
      <p class="faq-p fade-up">
        Still stuck? Open an issue on
        <a href={`${github}/issues`} target="_blank" rel="noopener noreferrer">GitHub</a> with
        your OS, install method, and the output above.
      </p>
    </div>
  </section>

</Base>

<style>
  .faq-hero {
    padding: clamp(3rem, 8vw, 5rem) 0 clamp(2rem, 5vw, 3rem);
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(91,43,234,0.06), transparent 65%),
      var(--bg);
    border-bottom: var(--hairline);
  }
  .faq-section { padding: clamp(2rem, 5vw, 3rem) 0; }
  .faq-section .h-section { margin-bottom: 1rem; }
  .faq-p {
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1rem;
    max-width: 62ch;
  }
  .faq-p code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--accent-tint);
    color: var(--accent);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }
  .faq-p strong { color: var(--ink); font-weight: 650; }
  .faq-p a { color: var(--accent); font-weight: 600; }
  .faq-p a:hover { color: var(--accent-hover); }
</style>

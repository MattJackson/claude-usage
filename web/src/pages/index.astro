---
// Home. Hero + product-shot, features grid, three-up usage-state trio,
// install snippet, footer CTA.
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import InstallSnippet from '../components/InstallSnippet.astro';

const title = 'usagio — see and swap your AI coding CLI quotas from the menu bar';
const description =
  'usagio is a native menu-bar app and CLI for macOS, Linux, and Windows that tracks usage and quotas across Claude Code, OpenAI Codex, and other AI coding CLIs. Multi-account per provider, no /login dance, auto-swap when a weekly limit hits. Free, MIT-licensed, single Rust binary.';

// SoftwareApplication node for the home page; merged into the site-wide
// @graph by Base.astro. Keep softwareVersion in sync with Cargo.toml.
const softwareApp = {
  '@type': 'SoftwareApplication',
  '@id': 'https://usagio.dev/#app',
  name: 'usagio',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description,
  url: 'https://usagio.dev/',
  downloadUrl: 'https://usagio.dev/download/',
  softwareVersion: '0.5.21',
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---
<Base title={title} description={description} path="/" current="home" jsonLd={softwareApp}>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy fade-up">
        <span class="eyebrow">MIT&nbsp;Licensed · 100%&nbsp;Rust · macOS · Linux · Windows</span>
        <h1 class="h-display hero-title">
          Every AI&nbsp;coding&nbsp;CLI. <br />
          <span class="hero-title-accent">One menu&nbsp;bar.</span>
        </h1>
        <p class="lede hero-lede">
          usagio tracks usage and quota across Claude Code, Codex, and every AI
          coding CLI you run — multiple accounts per provider, one keystroke to
          switch, and an auto-swap daemon that keeps you coding when a weekly
          limit hits.
        </p>
        <div class="btn-row hero-cta">
          <a class="btn btn-brand" href="/download/">Download</a>
          <a class="btn btn-secondary" href="https://github.com/MattJackson/usagio" target="_blank" rel="noopener noreferrer">View on GitHub</a>
        </div>
        <p class="hero-foot">Free &amp; open source · macOS · Linux · Windows</p>
      </div>

      <!-- Product shot: real usagio menu captures, rotating macOS -> Windows -> Linux.
           Pure-CSS crossfade (no JS); collapses to the macOS still under
           prefers-reduced-motion. -->
      <div class="hero-shot fade-up">
        <div class="hero-rotator" role="group" aria-label="usagio's menu on macOS, Windows, and Linux">
          <img class="hero-slide hero-slide-1" src="/hero-macos.png" width="945" height="630" loading="eager"
            alt="usagio's menu open on macOS, showing session and weekly quota for several Claude and Codex accounts" />
          <img class="hero-slide hero-slide-2" src="/screenshots/windows-menu-healthy.png" width="290" height="267" loading="eager"
            alt="usagio's menu open on Windows, showing the same account list" />
          <img class="hero-slide hero-slide-3" src="/screenshots/linux-menu-healthy.png" width="1600" height="900" loading="eager"
            alt="usagio's menu open on Linux, showing the same account list" />
          <span class="hero-os-badge" aria-hidden="true">
            <span class="hero-os hero-os-1">macOS</span>
            <span class="hero-os hero-os-2">Windows</span>
            <span class="hero-os hero-os-3">Linux</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHY USAGIO ============ -->
  <section class="whats-new">
    <div class="container">
      <div class="whats-new-head fade-up">
        <span class="eyebrow">Built to stay out of your way</span>
        <h2 class="h-section whats-new-title">Never re-login. Actually.</h2>
        <p class="lede whats-new-lede">
          Capture each account's login once. usagio never touches your active
          account's token — the vendor CLI owns it — so there's no recurring
          <code>/login</code> dance, on any provider.
        </p>
      </div>
      <div class="whats-new-grid">
        <article class="whats-new-card fade-up">
          <span class="whats-new-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1.5" y="2" width="9" height="6.5" rx="1"/>
              <rect x="5.5" y="7.5" width="9" height="6.5" rx="1"/>
            </svg>
          </span>
          <h3>usagio on macOS, Linux, and Windows</h3>
          <p>A native menu bar on all three — same menu, same auto-swap, same never-re-login guarantee, for both Claude Code and Codex.</p>
        </article>
        <article class="whats-new-card fade-up">
          <span class="whats-new-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 6h10M9.5 3l2.5 3-2.5 3"/>
              <path d="M14 10H4M6.5 7 4 10l2.5 3"/>
            </svg>
          </span>
          <h3>Codex — switch and go</h3>
          <p>Instantly swap between OpenAI Codex accounts too. <code>~/.codex/auth.json</code> is under usagio's control now.</p>
        </article>
        <article class="whats-new-card fade-up">
          <span class="whats-new-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="7" width="10" height="7" rx="1.2"/>
              <path d="M5 7V5a3 3 0 0 1 6 0v2"/>
            </svg>
          </span>
          <h3>No re-login loop</h3>
          <p>usagio never touches your active account's token — the vendor CLI owns it. Capture a login once and it stays valid; switching between accounts never triggers a fresh <code>/login</code>.</p>
        </article>
      </div>
      <p class="whats-new-foot fade-up"><a href="/whats-new/">See what changed →</a></p>
    </div>
  </section>

  <!-- ============ WHAT IT COVERS ============ -->
  <section class="providers section-soft">
    <div class="container">
      <div class="providers-head fade-up">
        <span class="eyebrow">One dashboard, every CLI</span>
        <h2 class="h-section">Ships with support for the CLIs you actually run.</h2>
        <p class="lede">
          First-party coverage for Claude Code and Codex today. Stubs and
          scaffolding for the rest are in the tree — provider adapters land as
          each CLI's usage surface stabilises.
        </p>
      </div>
      <ul class="provider-grid fade-up" role="list">
        {[
          { file: 'claude-code',  label: 'Claude Code', ready: true },
          { file: 'codex',        label: 'Codex',       ready: true },
          { file: 'cursor-agent', label: 'Cursor' },
          { file: 'opencode',     label: 'opencode' },
          { file: 'gemini-cli',   label: 'Gemini CLI' },
          { file: 'qwen-code',    label: 'Qwen' },
          { file: 'copilot-cli',  label: 'Copilot CLI' },
          { file: 'amazon-q',     label: 'Amazon Q' },
          { file: 'cline',        label: 'Cline' },
          { file: 'grok',         label: 'Grok' },
          { file: 'kimi',         label: 'Kimi' },
          { file: 'openrouter',   label: 'OpenRouter' },
          { file: 'deepseek',     label: 'DeepSeek' },
          { file: 'zai',          label: 'Z.ai' },
          { file: 'fireworks',    label: 'Fireworks' },
          { file: 'synthetic',    label: 'Synthetic' },
        ].map((p) => (
          <li class={`provider${p.ready ? ' provider-ready' : ''}`}>
            <img src={`/icons/${p.file}.svg`} width="18" height="18" alt="" loading="lazy" />
            <span class="provider-name">{p.label}</span>
            {p.vendor && <span class="provider-vendor">{p.vendor}</span>}
          </li>
        ))}
      </ul>
      <p class="provider-legend">
        <span class="dot dot-ready"></span> Shipping today
        <span style="margin-left: 1.5rem"><span class="dot dot-planned"></span> Planned / stub in tree</span>
      </p>
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="features">
    <div class="container">
      <div class="section-head fade-up">
        <span class="eyebrow">Built the way Mac tools should be</span>
        <h2 class="h-section">Native. Fast. Out of your way.</h2>
      </div>
      <div class="feature-grid">
        <article class="feature fade-up">
          <h3>Claude + Codex, macOS + Linux + Windows</h3>
          <p>Full support for both providers on all three OSes — one binary, one menu, the same never-re-login guarantee everywhere you code.</p>
        </article>
        <article class="feature fade-up">
          <h3>Session &amp; weekly at a glance</h3>
          <p>Each row shows session-window and weekly-quota use as a percentage, with reset countdowns on hover. No dashboards, no browser.</p>
        </article>
        <article class="feature fade-up">
          <h3>Multiple accounts per provider</h3>
          <p>Sign in more than once to Claude Max or Codex, switch which one <code>claude</code> or <code>codex</code> uses without touching <code>/login</code>.</p>
        </article>
        <article class="feature fade-up">
          <h3>Auto-swap daemon</h3>
          <p>When a weekly quota is about to hit, usagio drains accounts in reset order — the next account is already active before you notice the wall.</p>
        </article>
        <article class="feature fade-up">
          <h3>Menu bar first, CLI too</h3>
          <p>The same single Rust binary powers the menu-bar app and a scriptable CLI. Pipe usage into your shell prompt, or check it in a Raycast script.</p>
        </article>
        <article class="feature fade-up">
          <h3>OS-native secret storage, no webview</h3>
          <p>Tokens live in your OS keychain, not a file. One small binary per OS — no Electron, no bundled Chromium.</p>
        </article>
        <article class="feature feature-oss fade-up">
          <h3>Open source, single binary</h3>
          <p>Pure Rust. Install via Homebrew or build from source. The whole app is licensed <strong>MIT</strong> — run it anywhere, audit it, build on it.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ WHY OPEN SOURCE ============ -->
  <section class="why-oss">
    <div class="container container-narrow fade-up why-oss-inner">
      <span class="eyebrow">Why open source?</span>
      <p>
        usagio talks to first-party provider endpoints with tokens issued to
        <em>your</em> account. That's a lot of trust to give a closed
        binary. Every line is MIT-licensed and on
        <a href="https://github.com/MattJackson/usagio" target="_blank" rel="noopener noreferrer">GitHub</a>
        so you can audit exactly what it sends, where it stores state, and how
        the auto-swap decides when to move you.
      </p>
    </div>
  </section>

  <!-- ============ USAGE-STATE TRIO ============ -->
  <section class="states section-soft">
    <div class="container">
      <div class="section-head fade-up">
        <span class="eyebrow">One glance, the whole picture</span>
        <h2 class="h-section">Green when you're fine. Red when you're not.</h2>
        <p class="lede">
          The menu reads at a glance in every state — from a fresh Monday
          morning to the moment auto-swap catches a weekly ceiling.
        </p>
      </div>
      <div class="states-rows">
        <div class="states-row fade-up">
          <a class="states-shot" href="/screenshots/macos-menu-healthy.png" target="_blank" rel="noopener" aria-label="Open healthy-state screenshot in a new tab">
            <img src="/screenshots/macos-menu-healthy.png" alt="Healthy state — every account showing session and weekly percentages" width="945" height="630" loading="lazy" />
          </a>
          <div class="states-copy">
            <h3>Everything's under budget</h3>
            <p>All accounts under 60% weekly. Menu stays green; auto-swap keeps its powder dry until it's actually needed.</p>
          </div>
        </div>
        <div class="states-row states-row-flip fade-up">
          <a class="states-shot" href="/screenshots/macos-menu-mixed.png" target="_blank" rel="noopener" aria-label="Open mixed-state screenshot in a new tab">
            <img src="/screenshots/macos-menu-mixed.png" alt="Mixed state — some accounts show percentages, others a reset countdown" width="945" height="630" loading="lazy" />
          </a>
          <div class="states-copy">
            <h3>Two accounts, two colors</h3>
            <p>One account at 82% starts glowing amber. Another crosses 94% and turns red. Auto-swap has already picked the next candidate — you notice the color before you notice the wall.</p>
          </div>
        </div>
        <div class="states-row fade-up">
          <a class="states-shot" href="/screenshots/macos-menu-locked.png" target="_blank" rel="noopener" aria-label="Open locked-state screenshot in a new tab">
            <img src="/screenshots/macos-menu-locked.png" alt="Locked state — a weekly-locked account's row swaps its percentage for a reset countdown" width="945" height="630" loading="lazy" />
          </a>
          <div class="states-copy">
            <h3>The lockout turns into a countdown</h3>
            <p>When an account hits 100%, its percentage row swaps for a countdown to when it's usable again. Auto-swap flips to the next-priority account in the same tick — no interruption.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ONE MENU, THREE OSES ============ -->
  <section class="os-gallery-section">
    <div class="container">
      <div class="section-head fade-up">
        <span class="eyebrow">Native on every desktop</span>
        <h2 class="h-section">The same menu on macOS, Linux, and Windows.</h2>
        <p class="lede">
          One Rust binary, one menu bar, the same auto-swap and
          never-re-login guarantee — captured live on each OS.
        </p>
      </div>
      <div class="os-gallery fade-up">
        <figure class="os-shot">
          <a href="/screenshots/macos-menu-healthy.png" target="_blank" rel="noopener" aria-label="Open the macOS menu screenshot in a new tab">
            <img src="/screenshots/macos-menu-healthy.png" alt="usagio's menu open on macOS, listing accounts with session and weekly percentages" width="945" height="630" loading="lazy" />
          </a>
          <figcaption>macOS</figcaption>
        </figure>
        <figure class="os-shot">
          <a href="/screenshots/linux-menu-healthy.png" target="_blank" rel="noopener" aria-label="Open the Linux menu screenshot in a new tab">
            <img src="/screenshots/linux-menu-healthy.png" alt="usagio's menu open on Linux, listing accounts with session and weekly percentages" width="945" height="630" loading="lazy" />
          </a>
          <figcaption>Linux</figcaption>
        </figure>
        <figure class="os-shot">
          <a href="/screenshots/windows-menu-healthy.png" target="_blank" rel="noopener" aria-label="Open the Windows menu screenshot in a new tab">
            <img src="/screenshots/windows-menu-healthy.png" alt="usagio's menu open on Windows, listing accounts with session and weekly percentages" width="945" height="630" loading="lazy" />
          </a>
          <figcaption>Windows</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ INSTALL ============ -->
  <section class="install">
    <div class="container container-narrow">
      <div class="section-head fade-up" style="text-align: center;">
        <span class="eyebrow">Install</span>
        <h2 class="h-section">Two commands, no configuration.</h2>
        <p class="lede" style="margin-inline: auto;">
          <code>brew install</code> puts the binary on your PATH.
          <code>usagio install</code> wires up the menu-bar app and the
          auto-swap daemon, now and at every login.
        </p>
      </div>
      <div class="fade-up"><InstallSnippet /></div>
      <p class="install-note fade-up">
        Prefer a manual install, or building from source? <a href="/download/">See the download page →</a>
      </p>
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="cta-band">
    <div class="container cta-band-inner fade-up">
      <h2 class="h-section" style="color: #fff;">Stop hitting the wall at 3&nbsp;a.m.</h2>
      <p style="color: rgba(255,255,255,0.78); max-width: 46ch;">
        Install usagio. See every quota. Never lose a session to a limit you
        didn't know you were about to hit.
      </p>
      <div class="btn-row" style="justify-content: center;">
        <a class="btn btn-brand" href="/download/">Download</a>
        <a class="btn btn-ghost" style="color: #fff;" href="https://github.com/MattJackson/usagio" target="_blank" rel="noopener noreferrer">GitHub&nbsp;→</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ---- hero ---------------------------------------------------------- */
  .hero {
    padding-top: clamp(3rem, 8vw, 5.5rem);
    padding-bottom: clamp(3rem, 8vw, 5.5rem);
    background:
      radial-gradient(80% 60% at 15% 0%, rgba(91,43,234,0.06), transparent 60%),
      radial-gradient(60% 50% at 100% 20%, rgba(147,51,234,0.05), transparent 60%),
      var(--bg);
    border-bottom: var(--hairline);
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
  }
  .hero-title { margin-bottom: 1.1rem; }
  .hero-title-accent {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .hero-lede { margin-bottom: 1.75rem; }
  .hero-cta { margin-bottom: 1rem; }
  .hero-foot { color: var(--muted); font-size: var(--fs-sm); letter-spacing: 0.005em; }

  /* Product shot: a real macOS menu-bar capture in a lifted card. */
  .hero-shot {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
    border: 1px solid var(--line);
  }
  .hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Rotating hero: three real per-OS menu captures crossfading in order
     macOS -> Windows -> Linux. `contain` keeps each crisp despite differing
     native sizes; a subtle panel fills the letterbox. */
  .hero-rotator {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #10131a, #1c2230);
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    animation: heroCycle 13.5s infinite;
  }
  .hero-slide-1 { animation-delay: 0s; }
  .hero-slide-2 { animation-delay: 4.5s; }
  .hero-slide-3 { animation-delay: 9s; }
  @keyframes heroCycle {
    0%   { opacity: 0; }
    4%   { opacity: 1; }
    29%  { opacity: 1; }
    33%  { opacity: 0; }
    100% { opacity: 0; }
  }
  /* OS label chip, bottom-left, synced to the visible slide. */
  .hero-os-badge {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    height: 1.6rem;
  }
  .hero-os {
    position: absolute;
    left: 0;
    bottom: 0;
    white-space: nowrap;
    font: 600 0.72rem/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.02em;
    color: #fff;
    background: rgba(10, 13, 20, 0.66);
    backdrop-filter: blur(6px);
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    opacity: 0;
    animation: heroCycle 13.5s infinite;
  }
  .hero-os-1 { animation-delay: 0s; }
  .hero-os-2 { animation-delay: 4.5s; }
  .hero-os-3 { animation-delay: 9s; }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide, .hero-os { animation: none; }
    .hero-slide-1, .hero-os-1 { opacity: 1; }
    .hero-slide-2, .hero-slide-3, .hero-os-2, .hero-os-3 { opacity: 0; }
  }
  .hero-mock {
    margin: 0;
    padding: 1.4rem 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink);
    background: var(--bg);
    white-space: pre;
    overflow: auto;
  }
  .hm-provider { font-weight: 700; color: var(--ink); }
  .hm-row      { color: var(--muted); }
  .hm-active   { color: var(--ink); font-weight: 600; }
  .hm-pct      { color: var(--muted); float: right; }
  .hm-locked   { color: #d64545; float: right; }
  .hm-sep      { color: var(--hairline-color, #d0d0d5); }

  /* ---- what's new in 0.5.0 ------------------------------------------- */
  .whats-new { padding: clamp(2rem, 5vw, 3rem) 0 clamp(2.5rem, 6vw, 3.5rem); }
  .whats-new-head { max-width: 62ch; margin: 0 auto 2rem; text-align: center; }
  .whats-new-head .eyebrow { margin-bottom: 0.6rem; }
  .whats-new-title { margin-bottom: 0.75rem; }
  .whats-new-lede { margin-inline: auto; }
  .whats-new-lede code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--accent-tint);
    color: var(--accent);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }
  .whats-new-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(1rem, 2.5vw, 1.4rem);
    max-width: 1040px;
    margin: 0 auto;
  }
  .whats-new-card {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1.4rem 1.5rem;
    box-shadow: var(--shadow-1);
  }
  .whats-new-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border-radius: 8px;
    background: var(--accent-tint);
    color: var(--accent);
    margin-bottom: 0.85rem;
  }
  .whats-new-card h3 {
    font-size: var(--fs-h3);
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }
  .whats-new-card p {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.6;
  }
  .whats-new-card code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--accent-tint);
    color: var(--accent);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }
  .whats-new-foot {
    text-align: center;
    margin-top: 1.75rem;
    font-size: var(--fs-sm);
  }
  .whats-new-foot a { color: var(--accent); font-weight: 600; }
  .whats-new-foot a:hover { color: var(--accent-hover); }

  /* ---- providers ----------------------------------------------------- */
  .providers-head {
    max-width: 62ch;
    margin: 0 auto 2.5rem;
    text-align: center;
  }
  .providers-head .lede { margin-inline: auto; margin-top: 0.75rem; }
  .provider-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.55rem;
  }
  .provider {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 0.7rem 0.9rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
